import { Just } from "Maybe"
import { assertEquals, test } from "Test"

import Heap from "@/Hippo"



test(
  "Heaps have an intrinsic order: max",
  () => assertEquals(
    (Heap.root(Heap.singleton(4)) ?? -1) < (Heap.root(Heap.singleton(7)) ?? -1),
    false,
  ),
)
test(
  "Heaps have an intrinsic order: empty",
  () => assertEquals(prefer(Heap.empty, Heap.singleton(7)), true),
)
test(
  "Heaps have an intrinsic order: max out of order",
  () => assertEquals(prefer(Heap.singleton(100), Heap.singleton(7)), true),
)
