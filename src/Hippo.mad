import type { Comparison } from "Compare"
import type { Maybe } from "Maybe"

import Array from "Array"
import {} from "Bifunctor"
import { EQ, GT, LT } from "Compare"
import {} from "Compare"
import Fn from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing } from "Maybe"
import {} from "Monad"



alias Rank = Integer
export type Heap a = EmptyHeap | Heap(a, Rank, Heap a, Heap a)
// compareHeaps :: (Comparable a, Eq a) => Heap a -> Heap a -> Comparison
// compareHeaps = (a, b) => where(#[a, b]) {
//   #[Heap(_, _a, _, _), Heap(_, _b, _, _)] =>
//     _a < _b ? LT : _a == _b ? EQ : GT
//
//   _ =>
//     LT
// }
derive Comparable Heap
interface (Comparable a,
Eq a) => MaxHeap a {
  maxHeapify :: Integer -> Integer -> Array a -> Array a
}
instance (Comparable a,
Eq a) => MaxHeap a {
  maxHeapify = (i, size, xs) => {
    //  (i smaller than left or right child?)
    l = i * 2
    r = l + 1
    largest = i
    at = Array.unsafeAt($, xs)
    atIndex = at(i)
    atLargest = at(largest)
    if (l < size && at(l) > atIndex) do {
      largest := l
    } else do {}
    if (r < size && at(r) > atLargest) do {
      largest := r
    } else do {}
    return if (largest != i) do {
      ys = pipe(
        Array.unsafeSet(largest, atIndex),
        Array.unsafeSet(i, atIndex),
      )(xs)
      return maxHeapify(largest, size, ys)
    } else {
      return xs
    }
  }
}
export empty = EmptyHeap
export isEmpty = where {
  EmptyHeap =>
    true

  _ =>
    false
}
export singleton = Heap($, 1, EmptyHeap, EmptyHeap)
export rank = where {
  EmptyHeap =>
    0

  Heap(_, r, _, _) =>
    r
}
merge :: (MaxHeap a, Show a, Eq a, Comparable a) => Heap a -> Heap a -> Heap a
export merge = (a, b) => {
  return where(#[a, b]) {
    #[EmptyHeap, _b] =>
      _b

    #[_a, EmptyHeap] =>
      _a

    #[Heap(_a, aRank, aLeft, aRight), Heap(_b, bRank, bLeft, bRight)] =>
      if (aRank < bRank) {
        Heap(_a, aRank + 1, merge(aLeft, aRight), b)
      } else {
        Heap(_b, bRank + 1, a, merge(bLeft, bRight))
      }
  }
}
insert :: (Show a, Comparable a) => a -> Heap a -> Heap a
export insert = pipe(
  singleton,
  merge,
)
export insertB = (a, h) => pipe(
  singleton,
  merge($, h),
)(a)
export root = where {
  Heap(_a, _, _, _) =>
    Just(_a)

  EmptyHeap =>
    Nothing
}
export deleteRoot = where {
  EmptyHeap =>
    EmptyHeap

  Heap(_, _, left, right) =>
    merge(left, right)
}
foldLeft = (fn, acc, xs) => where(xs) {
  [x, ...rest] =>
    foldLeft(fn, fn(acc, x), rest)

  [] =>
    acc
}
// fromList :: List a -> Heap a 
export fromList = foldLeft((a, b) => insert(b, a), empty)
export toList = where {
  EmptyHeap =>
    []

  Heap(i, rk, l, r) =>
    [i, ...toList(merge(l, r))]
}
unfoldRight = (step, seed) => {
  go = (#[agg, o]) => where(o) {
    Nothing =>
      agg

    Just(vv) =>
      map(List.concat(vv), go(step(o)))
  }
  return go(step(seed))
}
export heapSort = pipe(
  fromList,
  toList,
)
