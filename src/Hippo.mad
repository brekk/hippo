import type { Comparison } from "Compare"
import type { Maybe } from "Maybe"

import Array from "Array"
import {} from "Bifunctor"
import { EQ, GT, LT } from "Compare"
import {} from "Compare"
import List from "List"
import { Just, Nothing } from "Maybe"
import {} from "Monad"



alias Rank = Integer
type Heap a = EmptyHeap | Heap(a, Rank, Heap a, Heap a)
compareHeaps :: (Comparable a, Eq a) => Heap a -> Heap a -> Comparison
compareHeaps = (a, b) => where(#[a, b]) {
  #[Heap(_a, _, _, _), Heap(_b, _, _, _)] =>
    _a < _b ? LT : _a == _b ? EQ : GT

  _ =>
    LT
}
instance (Comparable a,
Eq a) => Comparable (Heap a) {
  compare = compareHeaps
}
interface (Comparable a,
Eq a) => MaxHeap a {
  maxHeapify :: Integer -> Integer -> Array a -> Array a
}
instance (Comparable a,
Eq a) => MaxHeap (Heap a) {
  maxHeapify = (i, size, xs) => {
    //  (i smaller than left or right child?)
    l = i * 2
    r = l + 1
    largest = i
    at = Array.unsafeAt($, xs)
    atIndex = at(i)
    atLargest = at(largest)
    if (l < size && at(l) > atIndex) do {
      largest := l
    } else do {}
    if (r < size && at(r) > atLargest) do {
      largest := r
    } else do {}
    return if (largest != i) do {
      ys = pipe(
        Array.unsafeSet(largest, atIndex),
        Array.unsafeSet(i, atIndex),
      )(xs)
      return maxHeapify(largest, size, ys)
    } else {
      return xs
    }
  }
}
export sameType = (a, b) => where(#[a, b]) {
  #[EmptyHeap, EmptyHeap] =>
    true

  #[Heap(_, _, _, _), Heap(_, _, _, _)] =>
    true

  _ =>
    false
}
export empty = EmptyHeap
export isEmpty = where {
  EmptyHeap =>
    true

  _ =>
    false
}
export singleton = Heap($, 1, EmptyHeap, EmptyHeap)
export singletonMin = Heap($, 1, EmptyHeap, EmptyHeap)
export rank = where {
  EmptyHeap =>
    0

  Heap(_, r, _, _) =>
    r
}
merge :: (Comparable a, Eq a) => Heap a -> Heap a -> Heap a
merge = (a, b) => {
  node = (raw, n0, n1) => where(#[n0, n1]) {
    #[Heap(_n0, rank0, _, _), Heap(_n1, rank1, _, _)] =>
      Just(
        if (rank0 < rank1) {
          Heap(raw, rank0 + 1, n1, n0)
        } else {
          Heap(raw, rank1 + 1, n0, n1)
        },
      )

    _ =>
      Nothing
  }
  return where(#[a, b]) {
    #[EmptyHeap, _b] =>
      _b

    #[_a, EmptyHeap] =>
      _a

    #[Heap(_a, aRank, aLeft, aRight), Heap(_b, bRank, bLeft, bRight)] =>
      (
        if (_a < _b) {
          node(_a, aLeft, merge(aRight, b)) ?? EmptyHeap
        } else {
          node(_b, bLeft, merge(bRight, a)) ?? EmptyHeap
        }
      )
  }
}
// export insert = (a, b) => = merge(singleton(a), b)
export root = where {
  Heap(_a, _, _, _) =>
    Just(_a)

  EmptyHeap =>
    Nothing
}
export deleteRoot = where {
  EmptyHeap =>
    EmptyHeap

  Heap(_, _, left, right) =>
    merge(left, right)
}
